#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$HOME/Applications"
ICON_DIR="$HOME/.local/share/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

APP="$APP_DIR/Root.AppImage"
ICON="$ICON_DIR/rootapp.png"
DESKTOP="$DESKTOP_DIR/root.desktop"

APP_URL="https://installer.rootapp.com/installer/Linux/X64/Root.AppImage"
ICON_URL="https://raw.githubusercontent.com/shntsk/My-configs/refs/heads/main/unnamed%20(2).png"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$APP_DIR" "$ICON_DIR" "$DESKTOP_DIR"

echo "Baixando o Root..."
curl -fL --retry 3 "$APP_URL" -o "$TMP/Root.AppImage"

echo "Baixando o ícone personalizado..."
curl -fL --retry 3 "$ICON_URL" -o "$TMP/rootapp.png"

if ! head -c 8 "$TMP/rootapp.png" | grep -q $'\x89PNG\r\n\x1a\n'; then
    echo "Erro: o arquivo baixado não é um PNG válido."
    exit 1
fi

chmod +x "$TMP/Root.AppImage"

echo "Instalando o Root..."
install -m 755 "$TMP/Root.AppImage" "$APP.new"
mv -f "$APP.new" "$APP"

install -m 644 "$TMP/rootapp.png" "$ICON"

cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Root
GenericName=Chat e comunidades
Comment=Chat, voz e vídeo
Exec=appimage-run "$APP" %U
Icon=$ICON
Terminal=false
Categories=Network;InstantMessaging;
StartupNotify=true
EOF

echo
echo "Root instalado/atualizado com sucesso!"
echo "Ícone: $ICON"
echo "Atalho: $DESKTOP"
echo "Pesquise por Root no Fuzzel."
